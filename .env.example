APP_NAME="NG Home Cleaners"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (required stack default)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ng_home_cleaners
DB_USERNAME=postgres
DB_PASSWORD=

# Optional: SQLite for quick local bootstrap without PostgreSQL
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: leave unset (defaults to true when APP_ENV=production) or set SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Production (Laravel Cloud): CACHE_STORE=redis when a Redis/cache resource is attached

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — production uses Resend (https://resend.com)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="hello@nghomecleaners.co.uk"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Local development without Resend: write to storage/logs/laravel.log
# MAIL_MAILER=log

# Optional: Mailpit for local HTML mail preview (https://mailpit.axllent.org)
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public media disk: "public" locally. On Laravel Cloud, leave unset — when a
# bucket is attached (AWS_BUCKET is set), media automatically uses s3.
# Do NOT set MEDIA_DISK=public on Laravel Cloud (container disk is ephemeral).
# MEDIA_DISK=s3

# Livewire temp uploads stay on the local disk (required by TemporaryUploadedFile override).
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Analytics. Events always queue in the browser. Plausible only loads after cookie consent.
ANALYTICS_ENABLED=false
ANALYTICS_DRIVER=plausible
# PLAUSIBLE_DOMAIN=nghomecleaners.co.uk
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Production checklist (do not commit real secrets):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain
# SESSION_SECURE_COOKIE=true

# Public site (temporary until CRM Settings module)
NG_BUSINESS_NAME="NG Home Cleaners"
NG_PHONE=07503651476
NG_PHONE_DISPLAY="07503 651476"
NG_EMAIL=hello@nghomecleaners.co.uk
NG_WHATSAPP_URL=https://wa.me/447503651476
NG_HOURS="Every day, 8am–7pm"
NG_SERVICE_AREA="Nottingham and surrounding areas (NG1–NG16)"
